{
	"name": "taskanvil",
	"version": "0.1.0",
	"description": "A Linear agent you configure in code: labels route tickets to Claude Code sessions built from your own skills.",
	"license": "MIT",
	"author": "Adrian Oleszczak",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CukierPo2zl/taskanvil.git"
	},
	"homepage": "https://github.com/CukierPo2zl/taskanvil#readme",
	"bugs": {
		"url": "https://github.com/CukierPo2zl/taskanvil/issues"
	},
	"keywords": [
		"linear",
		"agent",
		"claude",
		"claude-code",
		"automation",
		"tickets"
	],
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=20.11",
		"pnpm": ">=9"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit && pnpm --dir web typecheck",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"ui:build": "pnpm --dir web build",
		"ui:dev": "pnpm --dir web dev"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.289",
		"@anthropic-ai/sdk": "^0.131.0",
		"@fastify/static": "^10.1.5",
		"@linear/sdk": "^88.0.0",
		"dotenv": "^16.4.0",
		"fastify": "^5.12.5",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.0.0",
		"tsx": "^4.23.15",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
