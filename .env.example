# Copy to .env and fill in. Never commit .env.

# --- Linear OAuth application (Linear → Settings → API → OAuth applications)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Signing secret from the application's webhook settings.
LINEAR_WEBHOOK_SECRET=

# --- Claude authentication (one of the two)
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# ...or the OAuth token printed by `claude setup-token` if you use a Claude subscription.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional
# Port the agent listens on (default 3456). The OAuth redirect URL uses it.
# AGENT_PORT=3456
# Interface to bind (default 127.0.0.1 — keep it local unless you know why not).
# AGENT_HOST=127.0.0.1
# Public URL of your tunnel (ngrok, cloudflared). Only used to print the webhook URL on /setup.
# AGENT_PUBLIC_URL=https://example.ngrok.app
# Model for the cheap directive-extraction call at intake.
# ANTHROPIC_MODEL_INTAKE=claude-haiku-4-5-20251001
